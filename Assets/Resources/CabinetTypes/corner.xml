<?xml version="1.0" encoding="utf-8"?>
<cabinetType id="corner" version="3" name="L alakú alsó sarokszekrény" unit="mm" finishedDimensions="true" heightIncludesPlinth="true">
  <!-- All cabinet dimensions are finished outside dimensions including 2 mm edge bands. -->
  <parameters>
    <param id="leftLength" default="950"/><param id="rightLength" default="950"/>
    <param id="leftDepth" default="560"/><param id="rightDepth" default="590"/>
    <param id="height" default="860"/><param id="plinth" default="80"/>
    <param id="boardThickness" default="18"/><param id="edgeBandThickness" default="2"/>
    <param id="braceWidth" default="100"/>
  </parameters>
  <materials>
    <material id="body" color="#20385B" thickness="$boardThickness"/>
    <material id="front" color="#20385B" thickness="$boardThickness"/>
    <material id="plinth" color="#A8A9AA" thickness="$boardThickness"/>
  </materials>
  <elements>
    <!-- BASE polygon outline coordinates are FINISHED dimensions, in the horizontal XZ plane.
         P1..P6 are clockwise around the L. The missing quadrant faces the room.
         Each edge has its own band. Raw polygon contour is offset INWARDS by the band. -->
    <element id="BASE" kind="polygonPanel" materialId="body" visibility="internal"
             width="$leftLength" height="$boardThickness" depth="$rightLength"
             x="0" y="$plinth" z="0">
      <outline>
        <point id="P1" x="$leftLength-$leftDepth" z="0"/>
        <point id="P2" x="$leftLength" z="0"/>
        <point id="P3" x="$leftLength" z="$rightLength"/>
        <point id="P4" x="0" z="$rightLength"/>
        <point id="P5" x="0" z="$rightLength-$rightDepth"/>
        <point id="P6" x="$leftLength-$leftDepth" z="$rightLength-$rightDepth"/>
      </outline>
      <edgeBands>
        <edge from="P1" to="P2" thickness="$edgeBandThickness"/>
        <edge from="P2" to="P3" thickness="$edgeBandThickness"/>
        <edge from="P3" to="P4" thickness="$edgeBandThickness"/>
        <edge from="P4" to="P5" thickness="$edgeBandThickness"/>
        <edge from="P5" to="P6" thickness="$edgeBandThickness"/>
        <edge from="P6" to="P1" thickness="$edgeBandThickness"/>
      </edgeBands>
      <anchors>
        <anchor id="InnerCorner" x="$leftLength-$leftDepth" y="$boardThickness" z="$rightLength-$rightDepth"/>
        <anchor id="LeftWingEnd" x="$leftLength" y="$boardThickness" z="0"/>
        <anchor id="RightWingEnd" x="0" y="$boardThickness" z="$rightLength"/>
      </anchors>
    </element>
    <!-- Panel heights are FINISHED. The top band is subtracted from raw cut height. -->
    <element id="LEFT" kind="panel" materialId="body" visibility="external"
             width="$boardThickness" height="$height-$plinth-$boardThickness" depth="$leftDepth"
             edgeFront="$edgeBandThickness" edgeBack="$edgeBandThickness" edgeTop="$edgeBandThickness">
      <placement><attach my="Bottom" to="BASE.Top" x="$leftLength-$boardThickness/2" z="$rightLength-$leftDepth/2"/></placement>
    </element>
    <element id="RIGHT" kind="panel" materialId="body" visibility="external"
             width="$rightDepth" height="$height-$plinth-$boardThickness" depth="$boardThickness"
             edgeLeft="$edgeBandThickness" edgeRight="$edgeBandThickness" edgeTop="$edgeBandThickness">
      <placement><attach my="Bottom" to="BASE.Top" x="$leftLength-$rightDepth/2" z="$rightLength-$boardThickness/2"/></placement>
    </element>
    <!-- R2 begins at inner corner and runs towards the right arm; R1 abuts R2 along left arm. -->
    <element id="R2" kind="panel" materialId="body" visibility="internal"
             width="$boardThickness" height="$height-$plinth-$boardThickness-$braceWidth" depth="$braceWidth"
             edgeFront="$edgeBandThickness" edgeBack="$edgeBandThickness">
      <placement><attach my="Bottom" to="BASE.InnerCorner" x="$boardThickness/2" z="$braceWidth/2"/></placement>
    </element>
    <element id="R1" kind="panel" materialId="body" visibility="internal"
             width="$braceWidth" height="$height-$plinth-$boardThickness-$braceWidth" depth="$boardThickness"
             edgeLeft="$edgeBandThickness">
      <placement><attach my="Bottom" to="R2.Left" x="-$braceWidth/2" z="-$braceWidth/2+$boardThickness/2"/></placement>
    </element>
    <!-- K1/K2 upright (vertical plane), their top is flush with cabinet top. -->
    <element id="K1" kind="panel" materialId="body" visibility="internal"
             width="$leftLength-$boardThickness-$edgeBandThickness" height="$braceWidth" depth="$boardThickness"
             edgeTop="$edgeBandThickness" edgeBottom="$edgeBandThickness" edgeLeft="$edgeBandThickness">
      <placement><attach my="Top" to="BASE.Top" x="$leftLength-$boardThickness-($leftLength-$boardThickness-$edgeBandThickness)/2" y="$height-$plinth-$boardThickness" z="$rightLength-$rightDepth+1.5*$boardThickness"/></placement>
    </element>
    <element id="K2" kind="panel" materialId="body" visibility="internal"
             width="$boardThickness" height="$braceWidth" depth="$rightLength-2*$boardThickness"
             edgeTop="$edgeBandThickness" edgeBottom="$edgeBandThickness">
      <placement><attach my="Top" to="BASE.Top" x="$leftLength-$leftDepth+$boardThickness/2" y="$height-$plinth-$boardThickness" z="$rightLength-$boardThickness-($rightLength-2*$boardThickness)/2"/></placement>
    </element>
    <!-- S1/S2 are horizontal panels. Their TOP is flush with cabinet top. -->
    <element id="S1" kind="panel" materialId="body" visibility="internal"
             width="$leftLength-2*$boardThickness" height="$boardThickness" depth="$braceWidth"
             edgeFront="$edgeBandThickness" edgeBack="$edgeBandThickness">
      <placement><attach my="Top" to="BASE.Top" x="$leftLength/2" y="$height-$plinth-$boardThickness" z="$rightLength-$rightDepth+1.5*$braceWidth"/></placement>
    </element>
    <element id="S2" kind="panel" materialId="body" visibility="internal"
             width="$braceWidth"
             height="$boardThickness" depth="$rightLength-($leftDepth-2*$edgeBandThickness)-$boardThickness-2*$edgeBandThickness"
             edgeLeft="$edgeBandThickness" edgeRight="$edgeBandThickness">
      <placement><attach my="Top" to="BASE.Top" x="$leftLength-$rightDepth/2" y="$height-$plinth-$boardThickness" z="$rightLength-$boardThickness-($rightLength-($leftDepth-2*$edgeBandThickness)-$boardThickness-2*$edgeBandThickness)/2"/></placement>
    </element>
  </elements>
  <slots><slot id="RIGHT_DRAWER" type="drawer" attachTo="S2"/></slots>
</cabinetType>