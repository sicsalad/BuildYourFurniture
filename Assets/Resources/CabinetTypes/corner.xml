<?xml version="1.0" encoding="utf-8"?>
<cabinetType id="corner" version="1" name="L alakú sarokszekrény" unit="mm" finishedDimensions="true">
 <parameters><param id="leftLength" default="950"/><param id="rightLength" default="950"/><param id="leftDepth" default="560"/><param id="rightDepth" default="590"/><param id="height" default="860"/><param id="plinth" default="80"/><param id="boardThickness" default="18"/><param id="edgeBandThickness" default="2"/><param id="braceWidth" default="100"/></parameters>
 <materials><material id="body" color="#20385B" thickness="$boardThickness"/><material id="front" color="#20385B" thickness="18"/><material id="plinth" color="#A8A9AA" thickness="18"/></materials>
 <elements>
  <element id="BASE" kind="lShapePanel" materialId="body" visibility="internal" width="$leftLength" height="$boardThickness" depth="$rightLength" leftDepth="$leftDepth" rightDepth="$rightDepth" x="0" y="$plinth" z="0" edgeFront="2" edgeBack="2" edgeLeft="2" edgeRight="2"/>
  <element id="LEFT" kind="panel" materialId="body" visibility="external" width="$boardThickness" height="$height-$plinth-$boardThickness" depth="$rightDepth" x="$leftLength-$boardThickness/2" y="$plinth+$boardThickness+($height-$plinth-$boardThickness)/2" z="$rightDepth/2" edgeFront="2" edgeBack="2" edgeTop="2" edgeBottom="0"/>
  <element id="RIGHT" kind="panel" materialId="body" visibility="external" width="$leftDepth" height="$height-$plinth-$boardThickness" depth="$boardThickness" x="$leftDepth/2" y="$plinth+$boardThickness+($height-$plinth-$boardThickness)/2" z="$rightLength-$boardThickness/2" edgeFront="2" edgeBack="2" edgeTop="2" edgeBottom="0"/>
  <element id="R1" kind="brace" materialId="body" visibility="internal" width="$braceWidth" height="$height-$plinth-$boardThickness-$braceWidth" depth="$boardThickness" x="$leftDepth-$braceWidth/2" y="$plinth+$boardThickness+($height-$plinth-$boardThickness-$braceWidth)/2" z="$rightDepth-$boardThickness/2" edgeFront="0" edgeBack="2"/>
  <element id="R2" kind="brace" materialId="body" visibility="internal" width="$boardThickness" height="$height-$plinth-$boardThickness-$braceWidth" depth="$braceWidth" x="$leftDepth-$boardThickness/2" y="$plinth+$boardThickness+($height-$plinth-$boardThickness-$braceWidth)/2" z="$rightDepth-$braceWidth/2" edgeFront="2" edgeBack="2"/>
  <element id="K1" kind="brace" materialId="body" visibility="internal" width="$leftLength-$boardThickness" height="$braceWidth" depth="$boardThickness" x="$leftLength/2" y="$height-$braceWidth/2" z="$boardThickness/2" edgeFront="2" edgeBack="2" edgeTop="2"/>
  <element id="K2" kind="brace" materialId="body" visibility="internal" width="$boardThickness" height="$braceWidth" depth="$rightLength-2*$boardThickness" x="$boardThickness/2" y="$height-$braceWidth/2" z="$rightLength/2" edgeFront="2" edgeBack="2"/>
  <element id="S1" kind="brace" materialId="body" visibility="internal" width="$leftLength-$boardThickness" height="$boardThickness" depth="$braceWidth" x="($leftLength+$boardThickness)/2" y="$height-$boardThickness/2" z="$rightDepth-$boardThickness/2" edgeFront="2" edgeBack="2"/>
  <element id="S2" kind="brace" materialId="body" visibility="internal" width="$braceWidth" height="$boardThickness" depth="$rightLength-$rightDepth" x="$leftDepth-$boardThickness/2" y="$height-$boardThickness/2" z="($rightLength+$rightDepth)/2" edgeFront="2" edgeBack="2"/>
 </elements>
 <slots><slot id="RIGHT_DRAWER" type="drawer" attachTo="S2" x="$leftDepth" y="$plinth+$boardThickness" z="$rightDepth" /></slots>
</cabinetType>